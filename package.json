{
  "name": "database-architect-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted data modeling: understand the domain, validate the model, approve visually, then generate artifacts.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dbarchitect": "node packages/cli/bin/dbarchitect.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/studio/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @dbarchitect/studio build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@dbarchitect/adapter-contracts": "workspace:*",
    "@dbarchitect/adapter-dapper": "workspace:*",
    "@dbarchitect/adapter-dotnet": "workspace:*",
    "@dbarchitect/adapter-ef-core": "workspace:*",
    "@dbarchitect/adapter-nodejs": "workspace:*",
    "@dbarchitect/adapter-prisma": "workspace:*",
    "@dbarchitect/adapter-sql": "workspace:*",
    "@dbarchitect/cli": "workspace:*",
    "@dbarchitect/core": "workspace:*",
    "@dbarchitect/engine": "workspace:*",
    "@dbarchitect/mcp-server": "workspace:*",
    "@dbarchitect/project-scanner": "workspace:*",
    "@dbarchitect/validators": "workspace:*",
    "@eslint/js": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
